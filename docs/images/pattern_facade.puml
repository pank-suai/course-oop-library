@startuml
top to bottom direction
skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 15
skinparam classAttributeFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 22
skinparam ArrowColor #17324D
skinparam ClassBorderColor #24739B
skinparam ClassBackgroundColor #E9F4FB
skinparam InterfaceBorderColor #735A9B
skinparam InterfaceBackgroundColor #F0EDFA
hide empty members

title Фасад: выполнение основных действий

interface "Основные действия\nLibraryService" as LibraryService {
  +issueLoan(readerId, publicationId, librarianId, now): Loan
  +returnLoan(loanId, now): Loan
  +deleteReader(readerId)
  +deletePublication(publicationId)
  +seedDemo(): Boolean
  +clearAll(): ClearAllResult
}
class "Выполнение действий\nRoomLibraryService" as RoomLibraryService {
  -repositories: LibraryRepositoryBundle
  -policy: LoanPolicy
  +issueLoan(...)
  +returnLoan(...)
  +seedDemo()
  +clearAll()
}
interface "Средства работы с данными\nLibraryRepositoryBundle" as LibraryRepositoryBundle
interface "Правила выдачи\nLoanPolicy" as LoanPolicy
class "Работа с базой\nRoomRepositoryBundle" as RoomRepositoryBundle
interface "Чтение и запись таблиц\nLibraryDao" as LibraryDao
class "Объекты управления экраном" as ViewModels <<группа участников>>

LibraryService <|.. RoomLibraryService
ViewModels --> LibraryService : короткие сценарии
RoomLibraryService --> LibraryRepositoryBundle : координирует
RoomLibraryService --> LoanPolicy : проверяет
LibraryRepositoryBundle <|.. RoomRepositoryBundle
RoomRepositoryBundle --> LibraryDao
@enduml
