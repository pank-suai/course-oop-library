@startuml
top to bottom direction
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classFontSize 18
skinparam classAttributeFontSize 16
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 24
hide empty members
title Наблюдатель: обновление списка читателей
interface "Чтение и запись таблиц\nLibraryDao" as LibraryDao {
 +observeReaders(): Flow<List<ReaderRecord>>
}
class "Хранение читателей\nRoomReaderRepository" as RoomReaderRepository {
 +readers: Flow<List<Reader>>
}
class "Управление списком читателей\nReadersViewModel" as ReadersViewModel {
 +state: StateFlow<CollectionUiState<Reader>>
}
class "Экран читателей\nReadersPane" as ReadersPane <<функция интерфейса>>
LibraryDao --> RoomReaderRepository : изменения записей
RoomReaderRepository --> ReadersViewModel : список читателей
ReadersViewModel --> ReadersPane : новое состояние списка
@enduml
