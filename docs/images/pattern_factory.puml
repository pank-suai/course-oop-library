@startuml
top to bottom direction
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classFontSize 18
skinparam classAttributeFontSize 16
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 24
hide empty members
title Фабрика: создание объектов библиотеки
class "Создание объектов\nLibraryEntityFactory" as LibraryEntityFactory {
 -ids: IdGenerator
 +reader(...): Reader
 +librarian(...): Librarian
 +branch(...): LibraryBranch
 +book(...): Book
 +periodical(...): Periodical
 +loan(...): Loan
}
interface "Создание идентификатора\nIdGenerator" as IdGenerator {
 +nextId(): String
}
class "Генератор идентификатора\nUuidIdGenerator" as UuidIdGenerator
class "Читатель\nReader" as Reader
class "Библиотекарь\nLibrarian" as Librarian
class "Филиал\nLibraryBranch" as LibraryBranch
class "Книга\nBook" as Book
class "Периодическое издание\nPeriodical" as Periodical
class "Выдача\nLoan" as Loan
IdGenerator <|.. UuidIdGenerator
LibraryEntityFactory --> IdGenerator
LibraryEntityFactory ..> Reader : создаёт
LibraryEntityFactory ..> Librarian : создаёт
LibraryEntityFactory ..> LibraryBranch : создаёт
LibraryEntityFactory ..> Book : создаёт
LibraryEntityFactory ..> Periodical : создаёт
LibraryEntityFactory ..> Loan : создаёт
Reader -[hidden]down-> Librarian
Book -[hidden]down-> Periodical
LibraryBranch -[hidden]down-> Loan
@enduml
