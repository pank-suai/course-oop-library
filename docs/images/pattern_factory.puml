@startuml
left to right direction
skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 15
skinparam classAttributeFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 32
skinparam ArrowColor #17324D
skinparam ClassBorderColor #24739B
skinparam ClassBackgroundColor #E9F4FB
skinparam InterfaceBorderColor #735A9B
skinparam InterfaceBackgroundColor #F0EDFA
hide empty members

title Паттерн Factory: создание сущностей

class LibraryEntityFactory {
  -ids: IdGenerator
  +reader(...): Reader
  +librarian(...): Librarian
  +branch(...): LibraryBranch
  +book(...): Book
  +periodical(...): Periodical
  +loan(...): Loan
}
interface IdGenerator {
  +nextId(): String
}
class UuidIdGenerator
class Reader
class Librarian
class LibraryBranch
class Book
class Periodical
class Loan

LibraryEntityFactory --> IdGenerator : получает UUID
IdGenerator <|.. UuidIdGenerator
LibraryEntityFactory ..> Reader : создаёт
LibraryEntityFactory ..> Librarian : создаёт
LibraryEntityFactory ..> LibraryBranch : создаёт
LibraryEntityFactory ..> Book : создаёт
LibraryEntityFactory ..> Periodical : создаёт
LibraryEntityFactory ..> Loan : создаёт
note bottom
  Конструкторы получают валидированные значения.
  seedDemo строит связанный граф и передаёт его
  в одну транзакцию Room.
end note
@enduml
