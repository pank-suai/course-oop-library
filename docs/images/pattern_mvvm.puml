@startuml
left to right direction
skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 15
skinparam classAttributeFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 26
skinparam ranksep 32
skinparam ArrowColor #17324D
skinparam ClassBorderColor #24739B
skinparam ClassBackgroundColor #E9F4FB
skinparam InterfaceBorderColor #735A9B
skinparam InterfaceBackgroundColor #F0EDFA
hide empty members

title Паттерн MVVM

package "View" {
  class App
  class LibraryScreen
  class ReadersPane
  class PublicationsPane
  class LoansPane
  class ArchitecturePane
}
package "ViewModel" {
  class ReadersViewModel {
    +state: StateFlow<CollectionUiState<Reader>>
    +setSearchQuery(value)
    +add(...): Boolean
    +delete(reader)
  }
  class PublicationsViewModel {
    +state: StateFlow<CollectionUiState<Publication>>
    +addBook(...)
    +addPeriodical(...)
    +delete(publication)
  }
  class LoansViewModel {
    +state: StateFlow<CollectionUiState<LoanRow>>
    +issue(reader, publication)
    +returnLoan(loan)
  }
  class AdministrationViewModel {
    +state: StateFlow<AdministrationUiState>
    +seedDemo()
    +clearAll()
  }
}
package "Model / application" {
  interface LibraryService
  class RoomLibraryService
}

App --> LibraryScreen
LibraryScreen --> ReadersPane
LibraryScreen --> PublicationsPane
LibraryScreen --> LoansPane
LibraryScreen --> ArchitecturePane
ReadersPane --> ReadersViewModel : events + state
PublicationsPane --> PublicationsViewModel : events + state
LoansPane --> LoansViewModel : events + state
ArchitecturePane --> AdministrationViewModel : events + state
ReadersViewModel --> LibraryService
PublicationsViewModel --> LibraryService
LoansViewModel --> LibraryService
AdministrationViewModel --> LibraryService
RoomLibraryService ..|> LibraryService
note bottom
  ViewModel принимает события UI, запускает корутины и публикует UiState.
  View получает только StateFlow и не знает SQL.
end note
@enduml
