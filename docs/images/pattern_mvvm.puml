@startuml
top to bottom direction
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classFontSize 18
skinparam classAttributeFontSize 16
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 24
hide empty members
title Разделение данных и экрана читателей (MVVM)
class "Экран читателей\nReadersPane" as ReadersPane <<функция интерфейса>>
class "Управление списком читателей\nReadersViewModel" as ReadersViewModel {
 +state: StateFlow<CollectionUiState<Reader>>
 +saveState: StateFlow<SaveUiState>
 +setSearchQuery(value: String)
 +add(...): Boolean
 +delete(reader: Reader)
}
interface "Данные читателей\nReaderRepository" as ReaderRepository
interface "Основные действия\nLibraryService" as LibraryService
class "Читатель\nReader" as Reader
ReadersPane --> ReadersViewModel
ReadersViewModel --> ReaderRepository
ReadersViewModel --> LibraryService
ReaderRepository ..> Reader
@enduml
