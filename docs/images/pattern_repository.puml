@startuml
top to bottom direction
skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 15
skinparam classAttributeFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 22
skinparam ArrowColor #17324D
skinparam ClassBorderColor #24739B
skinparam ClassBackgroundColor #E9F4FB
skinparam InterfaceBorderColor #735A9B
skinparam InterfaceBackgroundColor #F0EDFA
hide empty members

title Репозиторий: чтение и сохранение данных

package "Объекты библиотеки" {
  interface "Данные читателей\nReaderRepository" as ReaderRepository {
    +readers: Flow<List<Reader>>
    +readersOnce(): List<Reader>
    +findById(id): Reader?
    +save(reader)
    +delete(id)
  }
  interface "Данные изданий\nPublicationRepository" as PublicationRepository {
    +publications: Flow<List<Publication>>
    +publicationsOnce(): List<Publication>
    +findById(id): Publication?
    +save(publication)
    +delete(id)
  }
  interface "Данные выдач\nLoanRepository" as LoanRepository {
    +loans: Flow<List<Loan>>
    +findById(id): Loan?
    +issue(loan, maxActiveLoansPerReader): Boolean
    +returnLoan(id, returnedAt): Loan?
    +activeCountForReader(readerId): Int
    +refreshOverdue(now): Int
  }
}
package "Работа с базой данных" {
  class "Хранение читателей\nRoomReaderRepository" as RoomReaderRepository
  class "Хранение изданий\nRoomPublicationRepository" as RoomPublicationRepository
  class "Хранение выдач\nRoomLoanRepository" as RoomLoanRepository
  interface "Чтение и запись таблиц\nLibraryDao" as LibraryDao {
    +issueLoanAtomically(record, limit): Boolean
    +returnLoanAtomically(id, returnedAt): LoanRecord?
  }
  class ReaderRecord
  class PublicationRecord
  class LoanRecord
}

ReaderRepository <|.. RoomReaderRepository
PublicationRepository <|.. RoomPublicationRepository
LoanRepository <|.. RoomLoanRepository
RoomReaderRepository --> LibraryDao
RoomPublicationRepository --> LibraryDao
RoomLoanRepository --> LibraryDao
RoomReaderRepository ..> ReaderRecord
RoomPublicationRepository ..> PublicationRecord
RoomLoanRepository ..> LoanRecord
@enduml
