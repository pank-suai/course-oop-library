@startuml
top to bottom direction
skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 15
skinparam classAttributeFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 22
skinparam ArrowColor #17324D
skinparam ClassBorderColor #24739B
skinparam ClassBackgroundColor #E9F4FB
skinparam InterfaceBorderColor #735A9B
skinparam InterfaceBackgroundColor #F0EDFA
hide empty members

title Состояние: выдача, просрочка и возврат

class "Выдача\nLoan" as Loan {
  +state: LoanState
}
interface "Состояние выдачи\nLoanState" as LoanState {
  +status: String
}
class "Выдано\nActive" as Active
class "Просрочено\nOverdue" as Overdue
class "Возвращено\nReturned" as Returned {
  +returnedAt: Long
}

Loan --> LoanState : хранит
LoanState <|.. Active
LoanState <|.. Overdue
LoanState <|.. Returned
Active --> Overdue : срок возврата истёк
Active --> Returned : возврат / returnAt(timestamp)
Overdue --> Returned : возврат / returnAt(timestamp)
Returned ..> Returned : повторный возврат запрещён
@enduml
