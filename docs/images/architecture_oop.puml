@startuml
top to bottom direction
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classFontSize 18
skinparam classAttributeFontSize 16
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 24
hide empty members
title Общая диаграмма классов библиотечной системы
package "Предметная модель" {
interface "Общий объект библиотеки\nLibraryEntity" as LibraryEntity
interface "Человек\nPerson" as Person
interface "Издание\nPublication" as Publication
class "Читатель\nReader" as Reader
class "Библиотекарь\nLibrarian" as Librarian
class "Книга\nBook" as Book
class "Периодическое издание\nPeriodical" as Periodical
class "Филиал\nLibraryBranch" as LibraryBranch
class "Выдача\nLoan" as Loan
LibraryEntity <|-- Person
LibraryEntity <|-- Publication
LibraryEntity <|.. LibraryBranch
LibraryEntity <|.. Loan
Person <|.. Reader
Person <|.. Librarian
Publication <|.. Book
Publication <|.. Periodical
Reader "1" -- "0..*" Loan
Publication "1" -- "0..*" Loan
Librarian "1" -- "0..*" Loan
LibraryBranch "1" -- "0..*" Publication
}
package "Управление" {
interface "Основные действия\nLibraryService" as LibraryService
class "Выполнение действий\nRoomLibraryService" as RoomLibraryService
interface "Правила выдачи\nLoanPolicy" as LoanPolicy
class "Учебные правила\nDefaultLoanPolicy" as DefaultLoanPolicy
class "Создание объектов\nLibraryEntityFactory" as LibraryEntityFactory
LibraryService <|.. RoomLibraryService
LoanPolicy <|.. DefaultLoanPolicy
RoomLibraryService --> LoanPolicy
LibraryEntityFactory ..> LibraryEntity : создаёт сущности
}
package "Представление" {
class "Управление списком читателей\nReadersViewModel" as ReadersViewModel
class "Управление списком изданий\nPublicationsViewModel" as PublicationsViewModel
class "Управление выдачами\nLoansViewModel" as LoansViewModel
class "Учебные действия\nAdministrationViewModel" as AdministrationViewModel
class "Добавление учебных записей\nTestDataViewModel" as TestDataViewModel
class "Состояние операции\nSaveOperation" as SaveOperation
class "Учебный набор\nTestDataSeeder" as TestDataSeeder
class "Экранные компоненты\nCompose" as UI <<функции интерфейса>>
UI --> ReadersViewModel
UI --> PublicationsViewModel
UI --> LoansViewModel
UI --> AdministrationViewModel
UI --> TestDataViewModel
TestDataViewModel --> TestDataSeeder
ReadersViewModel --> SaveOperation
PublicationsViewModel --> SaveOperation
LoansViewModel --> SaveOperation
TestDataViewModel --> SaveOperation
ReadersViewModel --> LibraryService
PublicationsViewModel --> LibraryService
LoansViewModel --> LibraryService
AdministrationViewModel --> LibraryService
}
package "Хранение" {
interface "Средства работы с данными\nLibraryRepositoryBundle" as LibraryRepositoryBundle
class "Работа с базой\nRoomRepositoryBundle" as RoomRepositoryBundle
interface "Чтение и запись таблиц\nLibraryDao" as LibraryDao
class "База данных\nLibraryDatabase" as LibraryDatabase
LibraryRepositoryBundle <|.. RoomRepositoryBundle
RoomRepositoryBundle --> LibraryDao
LibraryDatabase --> LibraryDao : предоставляет
}
RoomLibraryService --> LibraryRepositoryBundle
TestDataSeeder --> LibraryRepositoryBundle
RoomRepositoryBundle ..> LibraryEntity : преобразует записи
LibraryEntityFactory -[hidden]right-> DefaultLoanPolicy
@enduml
