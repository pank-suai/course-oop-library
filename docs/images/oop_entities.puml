@startuml
top to bottom direction
skinparam backgroundColor #FBFDFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 15
skinparam classAttributeFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 22
skinparam ArrowColor #17324D
skinparam ClassBorderColor #24739B
skinparam ClassBackgroundColor #E9F4FB
skinparam InterfaceBorderColor #735A9B
skinparam InterfaceBackgroundColor #F0EDFA
skinparam NoteBackgroundColor #FFF5DF
skinparam NoteBorderColor #B87517
hide empty members

title Иерархия сущностей предметной области

interface "Общий объект библиотеки\nLibraryEntity" as LibraryEntity {
  +id: String
}
interface "Человек\nPerson" as Person {
  +fullName: String
}
interface "Издание\nPublication" as Publication {
  +title: String
  +authors: String
  +publisher: String
  +publicationYear: Int
  +totalCopies: Int
  +availableCopies: Int
  +branchId: String
}
class "Читатель\nReader" as Reader {
  +birthYear: Int
  +address: String
  +organization: String
}
class "Библиотекарь\nLibrarian" as Librarian {
  +position: String
  +branchId: String
}
class "Филиал\nLibraryBranch" as LibraryBranch {
  +name: String
  +address: String
}
class "Книга\nBook" as Book {
  +isbn: String?
}
class "Периодическое издание\nPeriodical" as Periodical {
  +issueNumber: Int
}
class "Выдача\nLoan" as Loan {
  +readerId: String
  +publicationId: String
  +librarianId: String
  +issuedAt: Long
  +dueAt: Long
  +state: LoanState
}

LibraryEntity <|-- Person
LibraryEntity <|-- Publication
LibraryEntity <|.. LibraryBranch
LibraryEntity <|.. Loan
Person <|.. Reader
Person <|.. Librarian
Publication <|.. Book
Publication <|.. Periodical

Reader "1" -- "0..*" Loan
Publication "1" -- "0..*" Loan
Librarian "1" -- "0..*" Loan
LibraryBranch "1" -- "0..*" Librarian
LibraryBranch "1" -- "0..*" Publication

@enduml
