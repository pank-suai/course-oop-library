[#soft("LibraryEntityFactory")], [reader, librarian, branch, book, periodical, loan], [создать соответствующий объект с новым идентификатором],
[#soft("LoanPolicy, DefaultLoanPolicy")], [#soft("canIssue(reader, publication, activeLoansForReader): PolicyDecision; dueAt(issuedAt, publication): Long")], [проверить допустимость выдачи и определить срок],
[Active, Overdue], [#soft("toString(): String")], [вернуть строковое имя состояния],
