@startuml
top to bottom direction
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 54
skinparam rectangleFontSize 56
skinparam linetype ortho
skinparam nodesep 48
skinparam ranksep 48
skinparam ArrowColor #274B6D
skinparam RectangleBorderColor #005AAA
skinparam RectangleBackgroundColor #EAF4FC
skinparam RectangleFontColor #17324D

rectangle "LibraryEntity\nобщий интерфейс · UUID" as Entity #DDEFFC
rectangle "Person\nчеловек" as Person #E8F6EE
rectangle "Publication\nиздание" as Publication #F1ECFA
rectangle "LibraryBranch\nфилиал" as Branch #FFF3D8
rectangle "Loan\nвыдача" as Loan #FFE8E8
rectangle "Reader\nчитатель" as Reader #E8F6EE
rectangle "Librarian\nбиблиотекарь" as Librarian #E8F6EE
rectangle "Book\nкнига · ISBN" as Book #F1ECFA
rectangle "Periodical\nпериодика · номер выпуска" as Periodical #F1ECFA

Entity <|-- Person
Entity <|-- Publication
Entity <|-- Branch
Entity <|-- Loan
Person <|-- Reader
Person <|-- Librarian
Publication <|-- Book
Publication <|-- Periodical

Person -[hidden]right- Publication
Publication -[hidden]right- Branch
Branch -[hidden]right- Loan
Reader -[hidden]right- Librarian
Librarian -[hidden]right- Book
Book -[hidden]right- Periodical
@enduml
